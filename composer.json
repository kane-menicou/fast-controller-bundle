      "": ""
    }
  },
  "require": {
      "symfony/symfony": "2.8.*|3.*.*"
  },
  "target-dir": "KaneMenicou/FastControllerBundle",
  "extra": {
    "branch-alias": {
      "master-dev": "0.1.0-dev"
    }
  }
