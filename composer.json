{
  "name": "kane-menicou/fast-controller-bundle",
  "description": "A bundle for creating crud controllers from config.",
  "type": "symfony-bundle",
  "config": {
    "platform": {
      "php": "7.1"
    }
  },
  "authors": [
    {
      "name": "Kane Menicou",
      "email": "kanemenicou@gmail.com"
    }
  ],
  "license": [
    "MIT"
  ],
  "autoload": {
